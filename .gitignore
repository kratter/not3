# Model weights and vendored binaries: gigabytes, all re-downloadable.
# scripts/fetch_whisper.py restores vendor/, scripts/fetch_models.py restores models/.
/models/
/vendor/

# Large or generated test fixtures (session.txt and jfk.wav are committed).
/tests/fixtures/bench*.wav

# Python
__pycache__/
*.py[cod]
*.spec
.venv/
.pytest_cache/
*.egg-info/

# Node / Tauri
node_modules/
/app/dist/
/app/src-tauri/target/
# Regenerated by tauri-build on every build from capabilities/.
/app/src-tauri/gen/
/app/src-tauri/icon-source.png
/engine/build/
/engine/dist/

# Local data
*.db
*.db-wal
*.db-shm
.DS_Store
